# Copy to .env and adjust. Read by docker compose and by the backend.

# Postgres (docker compose)
POSTGRES_DB=spmc
POSTGRES_USER=spmc
POSTGRES_PASSWORD=spmc
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://spmc:spmc@localhost:5432/spmc
SENSOR_MODE=simulated
# LATITUDE=19.9975
# LONGITUDE=73.7898
# TIMEZONE=Asia/Kolkata
